ARG BASE_IMAGE=debian:stable-slim
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends nfdump \
    && rm -rf /var/lib/apt/lists/*

VOLUME /flows

EXPOSE 9995/udp

ARG CONTENT_KEY=""
LABEL org.opencontainers.image.content-key="${CONTENT_KEY}"

ENTRYPOINT ["nfcapd"]
CMD ["-S", "2", "-w", "/flows/", "-p", "9995"]
